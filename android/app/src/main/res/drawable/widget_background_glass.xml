<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background with enhanced glass effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:centerColor="#25FFFFFF"
                android:endColor="#15FFFFFF"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Outer frosted glass border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#60FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Inner glow effect -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    
    <!-- Additional blur layer -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#10FFFFFF"
                android:angle="45" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
